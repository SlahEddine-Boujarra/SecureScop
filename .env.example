# SecureScope v5.3.6 OpenVAS/Nuclei configuration
# Copy this file to .env and replace every CHANGE_ME value.
# Never send or commit the completed .env file.

# ---------------------------------------------------------------------------
# Scanner fabric
# ---------------------------------------------------------------------------
# Enable one or both providers. The UI switcher affects new campaigns only.
SECURESCOPE_ENABLED_SCAN_ENGINES=OpenVAS,Nuclei
SECURESCOPE_DEFAULT_SCAN_ENGINE=Nuclei

# PostgreSQL
SECURESCOPE_DATABASE_URL=postgresql://securescope:CHANGE_ME@127.0.0.1:5432/securescope
# Shared UI/API repository pool. Defaults are appropriate for a local workstation.
SECURESCOPE_DB_POOL_MIN=1
SECURESCOPE_DB_POOL_MAX=12
SECURESCOPE_DEFAULT_CLIENT=Default Client

# Nmap
DEFAULT_NETWORK=192.168.100.0/24
NMAP_DETAIL_PORTS=-p-
NMAP_DETAIL_HOST_TIMEOUT=900s
NMAP_SECOND_PASS_DEFAULT_BATCH=5
NMAP_CONFIRM_HOST_TIMEOUT=300s
NMAP_CONFIRM_MAX_RETRIES=1

# OpenVAS / GVM through the local SSH tunnel
GVM_USERNAME=admin
GVM_PASSWORD=CHANGE_ME
LOCAL_TUNNEL_HOST=127.0.0.1
LOCAL_TUNNEL_PORT=19390

# Optional automatic SSH tunnel management used by start_securescope.ps1
OPENVAS_SSH_AUTOSTART=false
OPENVAS_SSH_HOST=
OPENVAS_SSH_USER=openvas
OPENVAS_SSH_KEY_PATH=
OPENVAS_GVMD_SOCKET=/run/gvmd/gvmd.sock
OPENVAS_TUNNEL_START_TIMEOUT_SECONDS=30
OPENVAS_TUNNEL_PROBE_TIMEOUT_SECONDS=1.0
GMP_TIMEOUT_SECONDS=600
# Live task/report metadata requests fail fast so one task cannot freeze the table.
GMP_STATUS_TIMEOUT_SECONDS=30
SCAN_CONFIG_NAME=Full and fast
PORT_LIST_NAME=All IANA assigned TCP
SCANNER_NAME=OpenVAS Default
# During stabilization the task creation command matches the old working
# implementation. Set OPENVAS_USE_ALIVE_TEST=true later when task creation is
# confirmed and targets need to bypass ICMP-only discovery.
OPENVAS_ALIVE_TEST=Consider Alive
OPENVAS_USE_ALIVE_TEST=false
# Optional deterministic task recovery is kept out of the creation path.
OPENVAS_RECOVER_BEFORE_CREATE=false
DEBUG_GVM=0

# Parallel OpenVAS batch execution
OPENVAS_MAX_CONCURRENT_SCANS=8
OPENVAS_ACTIVE_SLOT_FRESH_SECONDS=180
OPENVAS_PARALLEL_BATCH_SIZE=8
OPENVAS_MAX_SUBMISSION_ATTEMPTS=3
OPENVAS_WORKER_NAME=openvas-monitor
OPENVAS_WORKER_POLL_SECONDS=5
OPENVAS_QUEUE_START_POLL_SECONDS=3
OPENVAS_GVMD_INTERNAL_RETRY_SECONDS=15
OPENVAS_WORKER_ERROR_RETRY_SECONDS=10
OPENVAS_REQUESTED_DIAGNOSTIC_SECONDS=45
OPENVAS_FINALIZATION_ATTEMPTS=3
OPENVAS_REPORT_OUTPUT_ROOT=reports
REPORT_MAX_ROWS=2000

# ---------------------------------------------------------------------------
# ProjectDiscovery Nuclei (open-source local CLI)
# ---------------------------------------------------------------------------
# No API key is required for local open-source scanning.
# Run scripts/windows/install_nuclei_windows.ps1 or set an explicit path.
NUCLEI_BINARY=tools/nuclei/nuclei.exe
NUCLEI_TEMPLATES_DIR=
NUCLEI_DEFAULT_PROFILE=standard

# Safe process limits
NUCLEI_RATE_LIMIT=50
NUCLEI_BULK_SIZE=10
NUCLEI_CONCURRENCY=10
NUCLEI_REQUEST_TIMEOUT_SECONDS=10
NUCLEI_RETRIES=1
NUCLEI_MAX_HOST_ERRORS=20
NUCLEI_EXCLUDE_TAGS=dos,fuzz,fuzzing,bruteforce,creds-stuffing,token-spray
NUCLEI_DISABLE_INTERACTSH=false
NUCLEI_DISABLE_UNSIGNED_TEMPLATES=false
NUCLEI_DISABLE_UPDATE_CHECK=true

# Optional ProjectDiscovery Cloud upload.
# Authenticate outside SecureScope with: nuclei -auth
NUCLEI_DASHBOARD_UPLOAD=false

# Standalone Nuclei provider worker
NUCLEI_WORKER_AUTOSTART=true
NUCLEI_WORKER_NAME=nuclei-monitor
NUCLEI_WORKER_POLL_SECONDS=5
NUCLEI_WORKER_ERROR_RETRY_SECONDS=10
NUCLEI_WORKER_LOG_DIR=logs
NUCLEI_WORKER_LOG_LEVEL=INFO
NUCLEI_MAX_CONCURRENT_SCANS=2
NUCLEI_SYNC_LIMIT=100
NUCLEI_MAX_FINALIZATION_ATTEMPTS=3
NUCLEI_JOB_TIMEOUT_SECONDS=7200
NUCLEI_RUNNER_RESULT_GRACE_SECONDS=45
NUCLEI_DIAGNOSTIC_TIMEOUT_SECONDS=30
NUCLEI_WORK_ROOT=logs/nuclei_jobs
NUCLEI_REPORT_OUTPUT_ROOT=reports

# CISO Assistant
CISO_BASE_URL=https://ciso.local:8443
CISO_API_TOKEN=CHANGE_ME
CISO_VERIFY_TLS=false
CISO_TIMEOUT_SECONDS=30
CISO_SCOPE_FOLDER_NAME=Vulnerability Scanning Lab
CISO_PERIMETER_NAME=Internal Network 192.168.100.0-24
CISO_PERIMETER_STATUS=in_prod
CISO_RISK_ASSESSMENT_NAME=SecureScope Technical Risk Assessment
CISO_RISK_ASSESSMENT_REF_ID=securescope-technical-risk-assessment
CISO_RISK_MATRIX_ID=
CISO_MIN_CVSS_FOR_RISK=4.0

# Wazuh API
WAZUH_API_URL=https://CHANGE_ME:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=CHANGE_ME
WAZUH_VERIFY_TLS=true
WAZUH_TIMEOUT_SECONDS=30

# Wazuh Indexer
WAZUH_INDEXER_URL=https://CHANGE_ME:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME
WAZUH_INDEXER_VERIFY_TLS=true
WAZUH_INDEXER_ALERT_INDEX=wazuh-alerts-*

# NTP evidence
NTP_QUERY_TIMEOUT_SECONDS=2.5
NTP_OFFSET_TOLERANCE_MS=1000

# Application
MAX_SCAN_HISTORY=1000
LOG_LEVEL=INFO

# Reliable parallel start transport
OPENVAS_PARALLEL_START_WORKERS=8
GMP_START_TIMEOUT_SECONDS=90
OPENVAS_MISSING_TASK_GRACE_SECONDS=120

OPENVAS_LIVE_STALE_SECONDS=90

OPENVAS_FINALIZATIONS_PER_CYCLE=1

# v4.10.14 dispatch safety
OPENVAS_EXCLUSIVE_BATCH_DISPATCH=true
OPENVAS_AUTO_START_HISTORICAL_BATCHES=false

# v4.10.15 live task-status polling
GMP_FAST_STATUS_TIMEOUT_SECONDS=20
OPENVAS_FAST_STATUS_POLL_SECONDS=5
OPENVAS_FAST_STATUS_JOB_LIMIT=24
OPENVAS_FAST_STATUS_EXACT_WORKERS=2
OPENVAS_PRIORITY_STATUS_POLL_SECONDS=5
OPENVAS_PRIORITY_WATCH_TTL_SECONDS=30
OPENVAS_DEEP_RECONCILE_SECONDS=30

# ---------------------------------------------------------------------------
# Wazuh endpoint clock assurance for ISO/IEC 27001:2022 A.8.17
# ---------------------------------------------------------------------------
# Supporting comparison: endpoint UTC epoch versus Wazuh event receipt time.
# This includes transport and indexing delay, so use a wider tolerance.
NTP_MANAGER_DELTA_TOLERANCE_MS=5000
# Evidence older than this value is reported as stale, not compliant.
NTP_EVIDENCE_MAX_AGE_MINUTES=15
# Event marker emitted by the supplied Windows/Linux Wazuh probes.
WAZUH_NTP_MARKER=SECURESCOPE_NTP

# ---------------------------------------------------------------------------
# Vulnerability intelligence and remediation assistance
# ---------------------------------------------------------------------------
# Optional NVD API key. The application also works without it at lower rate limits.
NVD_API_KEY=
VULNERABILITY_INTELLIGENCE_CACHE_HOURS=24

# Deterministic remediation plans are always available.
# Optional AI refinement requires a compatible HTTP endpoint and must be reviewed.
AI_REMEDIATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
AI_REMEDIATION_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Approved endpoint remediation (default-off safety boundary)
# ---------------------------------------------------------------------------
# Both switches must be true before a Wazuh Active Response can be dispatched.
WAZUH_REMEDIATION_EXECUTION_ENABLED=false
REMEDIATION_WORKER_AUTOSTART=false
# Exact Wazuh <command><name> identifiers approved by an administrator.
WAZUH_REMEDIATION_COMMAND_ALLOWLIST=
REMEDIATION_WORKER_NAME=remediation-worker
REMEDIATION_WORKER_POLL_SECONDS=5
# Wait before starting a fresh targeted verification scan.
REMEDIATION_VERIFICATION_DELAY_SECONDS=3600
REMEDIATION_VERIFICATION_ENGINE=Nuclei
REMEDIATION_VERIFICATION_PROFILE=standard

# ---------------------------------------------------------------------------
# GRC Workspace, ISO Evidence Hub and FastAPI control plane (v5.3.8)
# ---------------------------------------------------------------------------
# Disable only while diagnosing an incomplete database upgrade.
SECURESCOPE_GRC_WORKSPACE_ENABLED=true
# Streamlit actions are authorized through a real workspace membership.
SECURESCOPE_CURRENT_USER_EMAIL=
# Raw evidence is stored outside PostgreSQL. Use a protected durable volume in production.
SECURESCOPE_EVIDENCE_STORAGE_ROOT=evidence_store
SECURESCOPE_EVIDENCE_MAX_UPLOAD_BYTES=26214400
# Optional Fernet key. Generate with the command documented in docs/ISO_EVIDENCE_HUB.md.
SECURESCOPE_EVIDENCE_ENCRYPTION_KEY=

# Defensive collector worker. Local code/config scans are restricted to this root.
SECURESCOPE_COLLECTOR_ALLOWED_ROOT=
SECURESCOPE_EVIDENCE_WORK_ROOT=logs/evidence_jobs
EVIDENCE_WORKER_NAME=evidence-worker
EVIDENCE_WORKER_AUTOSTART=false
EVIDENCE_WORKER_POLL_SECONDS=5
EVIDENCE_WORKER_LOG_LEVEL=INFO

# FastAPI is private by default and is not required for the Streamlit UI.
SECURESCOPE_API_HOST=127.0.0.1
SECURESCOPE_API_PORT=8765

# Host identities allowed to edit shared connector configuration (also require workspace Administrator).
SECURESCOPE_CONNECTOR_ADMINS=
# Supply SECURESCOPE_CREDENTIAL_ENCRYPTION_KEY through the host secret environment.
# Do not bundle it with the encrypted data/wazuh_connection.enc store.
SECURESCOPE_CREDENTIAL_ENCRYPTION_KEY=

# Populated toolkit exports
# Override these only when templates or LibreOffice are installed elsewhere.
SECURESCOPE_TOOLKIT_TEMPLATES_DIR=config/toolkit_templates
SECURESCOPE_SOFFICE_PATH=
